# Copie a .env (local) o cargue estos valores en las variables de entorno del hosting. NUNCA suba .env a Git.
APP_ENV=dev            # usar "prod" en el servidor real
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# GUARDAR UNA COPIA FUERA DEL SERVIDOR: sin esta clave no se puede descifrar nada.
ENCRYPTION_KEY=
DATABASE_URL=sqlite:///./cibertriage.db   # en producción: la URL de PostgreSQL
ADMIN_USER=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
TRUST_PROXY=0          # 1 detrás de Render/Nginx (para registrar la IP real)
